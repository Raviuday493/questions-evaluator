{
  "openapi": "3.0.3",
  "info": {
    "title": "Question Paper Intelligence (QPI) API",
    "version": "1.0.0",
    "description": "API endpoints for Question Paper Analysis, Match Reporting, and Next-Paper Preparation Insights."
  },
  "paths": {
    "/api/v1/papers/upload": {
      "post": {
        "summary": "Upload a draft or historical question paper",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "course_id", "academic_year", "term", "exam_type", "total_marks"],
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "PDF or DOCX file (max 25MB)" },
                  "course_id": { "type": "string", "format": "uuid" },
                  "academic_year": { "type": "string", "example": "2025-2026" },
                  "term": { "type": "string", "example": "Fall" },
                  "exam_type": { "type": "string", "example": "Midterm" },
                  "total_marks": { "type": "integer", "example": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "File accepted and processing queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paper_id": { "type": "string", "format": "uuid" },
                    "status": { "type": "string", "example": "QUEUED" },
                    "status_url": { "type": "string", "example": "/api/v1/papers/123e4567-e89b-12d3-a456-426614174000/status" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/papers/{id}/status": {
      "get": {
        "summary": "Get processing status of an uploaded paper",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Job status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paper_id": { "type": "string", "format": "uuid" },
                    "status": { "type": "string", "enum": ["QUEUED", "PARSING", "EMBEDDING", "MATCHING", "COMPLETED", "FAILED"] },
                    "progress_percent": { "type": "integer", "example": 65 },
                    "current_step": { "type": "string", "example": "Scanning historical archive..." },
                    "report_id": { "type": "string", "format": "uuid", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{id}": {
      "get": {
        "summary": "Get QPI Originality & Match Report",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Report retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "report_id": { "type": "string", "format": "uuid" },
                    "paper_id": { "type": "string", "format": "uuid" },
                    "originality_score": { "type": "number", "example": 88.5 },
                    "total_questions": { "type": "integer", "example": 25 },
                    "matched_questions_count": { "type": "integer", "example": 3 },
                    "matched_questions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "question_number": { "type": "string", "example": "4" },
                          "draft_text": { "type": "string" },
                          "match_tier": { "type": "string", "example": "EXACT" },
                          "composite_score": { "type": "number", "example": 0.95 },
                          "source_paper": { "type": "string", "example": "2021 Final Exam" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/{id}/insights": {
      "get": {
        "summary": "Get QPI Preparation Insights (Syllabus, Bloom's Taxonomy, Recommendations)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Preparation insights retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "draft_freshness_score": { "type": "number", "example": 85.0 },
                    "unit_coverage": { "type": "object" },
                    "blooms_distribution": { "type": "object" },
                    "overused_topics": { "type": "array", "items": { "type": "string" } },
                    "recommendations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "priority": { "type": "integer", "example": 1 },
                          "action_text": { "type": "string" },
                          "rationale": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
