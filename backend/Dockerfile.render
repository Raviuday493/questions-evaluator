# Lightweight image for small free-tier hosts (e.g. Render free: 512 MB RAM).
# Omits PyTorch/sentence-transformers; set EMBEDDING_PROVIDER=hashing when using it.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY . .

EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && python -m scripts.seed --samples-dir /tmp/samples && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
