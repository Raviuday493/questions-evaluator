# Copy to backend/.env (git-ignored). Every setting has a development default in app/core/config.py.
ENVIRONMENT=development                # 'production' enforces a real JWT secret and secure cookies

# Database (sync driver; a '+asyncpg' URL is mapped to psycopg2 automatically)
DATABASE_URL=postgresql+psycopg2://qpi:secret@localhost:5432/qpi_db

# Analysis jobs: 'background' runs in the API process; 'celery' needs Redis + a worker
TASK_QUEUE=background
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# File storage: 'local' (filesystem) or 'database' (stored_files table)
STORAGE_TYPE=local
# LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Similarity
EXACT_MATCH_THRESHOLD=0.90
PARAPHRASE_MATCH_THRESHOLD=0.75
CONCEPTUAL_MATCH_THRESHOLD=0.60
SEMANTIC_WEIGHT=0.70
SIMILARITY_LOOKBACK_YEARS=10

# Embeddings: sentence_transformers (needs requirements-ml.txt), hashing (no ML deps), or mock (tests)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-mpnet-base-v2
EMBEDDING_DIMENSION=768

# Security -- generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# COOKIE_SECURE=true                   # defaults to true when ENVIRONMENT=production
# Explicit origins only ('*' is rejected): main site (3000) and admin panel (3001).
# Production example: CORS_ORIGINS=https://qpi.example.edu,https://admin.qpi.example.edu
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Admin panel sessions (opaque server-side tokens, separate from user JWTs)
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_MAX_HOURS=12
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
STUCK_JOB_MINUTES=30

# Optional: Google Gemini key for ADK agents (not required by the analysis pipeline)
# GEMINI_API_KEY=
